# The S3 receiver (make s3): its own USB carries the chunks, so nothing else may print there.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Receive buffers for the camera's shards at VGA (about 600 a second of 1.4 KB, 2026-11-14): at the defaults (10 static, 32 dynamic) 55-84% of VGA frames came up short at every PHY rate with nothing refused by fpv_rx's own buffer.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=10
