// The drone's settings: the one list that names, bounds, defaults and persists every value (settings.c).
// TUNE(name, Command member, scale to the member, min, max, default): changed by the T request.
// STATE(name, min, max, default): set only by IMU calibration (G), servo zeroing (Z), accel correction (Q) and the level reference (L); read-only to T.
// Every entry is persisted in NVS. Angles are degrees here; RAD converts trims to the controller's radians.
// Defaults match sw/sim/flight.py DEFAULT_TUNING and MODEL, which the host simulation uses.
TUNE(roll_p, roll_p, 1, 0, 1000, 20)
TUNE(roll_i, roll_i, 1, 0, 1000, 3)
TUNE(roll_damping, roll_damping, 1, 0, 1000, 6)
TUNE(pitch_p, pitch_p, 1, 0, 1000, 20)
TUNE(pitch_i, pitch_i, 1, 0, 1000, 3)
TUNE(pitch_damping, pitch_damping, 1, 0, 1000, 10)
TUNE(yaw_damping, yaw_damping, 1, 0, 1000, 4)
TUNE(integral_limit, integral_limit, 1, 0, 1000, 3)
TUNE(pitch_trim, pitch_trim, RAD, -15, 15, 0)
TUNE(left_trim, left_trim, RAD, -15, 15, 0.9)
TUNE(right_trim, right_trim, RAD, -15, 15, -0.9)
TUNE(pivot_height, model.pivot_height, 1, 0.000001, 1, 0.0253692458911615)
TUNE(com_x, model.com_x, 1, -0.02, 0.02, 0)
TUNE(roll_inertia, model.roll_inertia, 1, 0.000001, 1, 0.0118483264434811)
TUNE(pitch_inertia, model.pitch_inertia, 1, 0.000001, 1, 0.0023030647846826)
TUNE(yaw_inertia, model.yaw_inertia, 1, 0.000001, 1, 0.0106709253540914)
TUNE(reaction_torque_ratio, model.reaction_torque_ratio, 1, -0.1, 0.1, 0.015)
TUNE(arm, model.arm, 1, 0.001, 1, 0.172)
TUNE(roll_bias, roll_bias, 1, -20, 20, 0)
TUNE(pitch_bias, pitch_bias, 1, -20, 20, 0)
TUNE(yaw_bias, yaw_bias, 1, -10, 10, 0)
TUNE(left_thrust_scale, left_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(right_thrust_scale, right_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(servo_compensation, servo_compensation, RAD, 0, 3, 0.75)
TUNE(integrate_throttle, integrate_throttle, 1, 0, 1200, 580)
TUNE(target_rate, target_rate, RAD, 1, 360, 360)
TUNE(velocity_damping, velocity_damping, RAD, 0, 30, 8)
TUNE(velocity_leak, velocity_leak, 1, 0.1, 30, 3)
TUNE(thrust_voltage, thrust_voltage, 1, 0, 20, 0)
TUNE(yaw_i, yaw_i, 1, 0, 100, 0)
TUNE(hover_camera, hover_camera, 1, 0, 1, 1)
TUNE(hover_kp, hover.kp, 1, 0, 20, 2)
TUNE(hover_kd, hover.kd, 1, 0, 20, 2)
TUNE(hover_tilt, hover.tilt, RAD, 0, 15, 8)
TUNE(hover_kside, hover.kside, 1, 0, 5, 0.5)
TUNE(hover_kz, hover.kz, 1, 0, 10, 1.5)
TUNE(hover_kdz, hover.kdz, 1, 0, 20, 4)
TUNE(hover_kiz, hover.kiz, 1, 0, 20, 2)
TUNE(hover_mass, hover.mass, 1, 0.3, 2, 0.9)
TUNE(hover_climb, hover.climb, 1, 0, 1.5, 0.3)
TUNE(hover_climb_rate, hover.climb_rate, 1, 0.05, 1, 0.3)
TUNE(hover_land_rate, hover.land_rate, 1, 0.05, 0.5, 0.2)
TUNE(hover_kyaw, hover.kyaw, 1, 0, 10, 2)
TUNE(hover_yaw_rate, hover.yaw_rate, RAD, 0, 90, 30)
TUNE(hover_center, hover.center, 1, 0, 1, 1)
TUNE(hover_distance, hover.distance, 1, 0, 5, 1.79)
TUNE(hover_approach, hover.approach, 1, 0.02, 1, 0.25)
TUNE(hover_ceiling, hover.ceiling, 1, 0.2, 3, 1.8)
TUNE(hover_square, hover.square, 1, 0, 1, 1)
TUNE(hover_cam_pitch, hover.cam_pitch, RAD, -30, 30, 4.3)
TUNE(hover_cam_roll, hover.cam_roll, RAD, -180, 180, 0)
TUNE(hover_drag, hover.drag, 1, 0, 2, 0)
TUNE(hover_drag_tilt, hover.drag_tilt, RAD, -10, 10, 1.4)
TUNE(hover_drag_tau, hover.drag_tau, 1, 0.1, 10, 0.7)
TUNE(hover_trim_tau, hover.trim_tau, 1, 0.1, 20, 1.5)
TUNE(hover_trim_max, hover.trim_max, 1, 0, 3, 1)
TUNE(hover_thrust_tilt, hover.thrust_tilt, 1, 0, 1.5, 0)
TUNE(hover_thrust_tilt_tau, hover.thrust_tilt_tau, 1, 0.05, 10, 1)
TUNE(hover_trim_start_x, hover.trim_start_x, 1, -3, 3, 0)
TUNE(hover_trim_start_y, hover.trim_start_y, 1, -3, 3, 0)
TUNE(auto_trim, auto_trim, 1, 0, 1, 0)
STATE(servo_offset_left, -60, 60, -3)
STATE(servo_offset_right, -60, 60, 0)
// Gyro bias in rad/s and the stationary pose in degrees, valid only for the sensor frame they were taken in:
// calibration_frame holds the sign bits (x 1, y 2, z 4) of runtime.h sensor_to_body and the sensor_axis order above them.
STATE(gyro_bias_x, -1, 1, 0)
STATE(gyro_bias_y, -1, 1, 0)
STATE(gyro_bias_z, -1, 1, 0)
// The drone's level attitude as the IMU sees it, set by tools/level.py.
STATE(pose_zero_roll, -180, 180, 0)
STATE(pose_zero_pitch, -90, 90, 0)
// Accelerometer correction in body axes, from tools/accel_cal.py: corrected = (measured - offset) * gain, in g.
STATE(accel_offset_x, -0.2, 0.2, 0)
STATE(accel_offset_y, -0.2, 0.2, 0)
STATE(accel_offset_z, -0.2, 0.2, 0)
STATE(accel_gain_x, 0.8, 1.2, 1)
STATE(accel_gain_y, 0.8, 1.2, 1)
STATE(accel_gain_z, 0.8, 1.2, 1)
STATE(calibrated, 0, 1, 0)
STATE(calibration_frame, 0, 511, 0)
