// The drone's settings: the one list that names, bounds, defaults and persists every value (settings.c).
// TUNE(name, Command member, scale to the member, min, max, default): changed by the T request.
// STATE(name, min, max, default): set only by IMU calibration (G), servo zeroing (Z), accel correction (Q) and the level reference (L); read-only to T.
// Every entry is persisted in NVS. Angles are degrees here; RAD converts trims to the controller's radians.
// Defaults match sw/sim/flight.py DEFAULT_TUNING and MODEL, which the host simulation uses.
TUNE(roll_p, roll_p, 1, 0, 1000, 20)
TUNE(roll_i, roll_i, 1, 0, 1000, 3)
TUNE(roll_damping, roll_damping, 1, 0, 1000, 6)
TUNE(pitch_p, pitch_p, 1, 0, 1000, 20)
TUNE(pitch_i, pitch_i, 1, 0, 1000, 3)
TUNE(pitch_damping, pitch_damping, 1, 0, 1000, 10)
TUNE(yaw_damping, yaw_damping, 1, 0, 1000, 4)
TUNE(integral_limit, integral_limit, 1, 0, 1000, 3)
TUNE(pitch_trim, pitch_trim, RAD, -15, 15, 0)
TUNE(left_trim, left_trim, RAD, -15, 15, 0.9)
TUNE(right_trim, right_trim, RAD, -15, 15, -0.9)
TUNE(pivot_height, model.pivot_height, 1, 0.000001, 1, 0.0253692458911615)
TUNE(com_x, model.com_x, 1, -0.02, 0.02, 0)
TUNE(roll_inertia, model.roll_inertia, 1, 0.000001, 1, 0.0118483264434811)
TUNE(pitch_inertia, model.pitch_inertia, 1, 0.000001, 1, 0.0023030647846826)
TUNE(yaw_inertia, model.yaw_inertia, 1, 0.000001, 1, 0.0106709253540914)
TUNE(reaction_torque_ratio, model.reaction_torque_ratio, 1, -0.1, 0.1, 0.015)
TUNE(arm, model.arm, 1, 0.001, 1, 0.172)
TUNE(roll_bias, roll_bias, 1, -20, 20, 0)
TUNE(pitch_bias, pitch_bias, 1, -20, 20, 0)
TUNE(yaw_bias, yaw_bias, 1, -10, 10, 0)
TUNE(left_thrust_scale, left_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(right_thrust_scale, right_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(servo_compensation, servo_compensation, RAD, 0, 3, 0.75)
TUNE(integrate_throttle, integrate_throttle, 1, 0, 1200, 580)
TUNE(target_rate, target_rate, RAD, 1, 360, 360)
TUNE(roll_target_rate, roll_target_rate, RAD, 0, 360, 0)
TUNE(velocity_damping, velocity_damping, RAD, 0, 30, 8)
TUNE(velocity_leak, velocity_leak, 1, 0.1, 30, 3)
TUNE(thrust_voltage, thrust_voltage, 1, 0, 20, 0)
TUNE(yaw_i, yaw_i, 1, 0, 100, 0)
TUNE(pitch_speed, pitch_speed, 1, -50, 50, 0)
TUNE(hover_camera, hover_camera, 1, 0, 1, 1)
TUNE(hover_kp, hover.kp, 1, 0, 20, 2)
TUNE(hover_kd, hover.kd, 1, 0, 20, 2)
TUNE(hover_tilt, hover.tilt, RAD, 0, 30, 8)
TUNE(hover_kside, hover.kside, 1, 0, 5, 0.5)
TUNE(hover_kz, hover.kz, 1, 0, 10, 1.5)
TUNE(hover_kdz, hover.kdz, 1, 0, 20, 4)
TUNE(hover_kiz, hover.kiz, 1, 0, 20, 2)
TUNE(hover_mass, hover.mass, 1, 0.3, 2, 0.9)
// hover_climb and hover_ceiling go to 5 m at most, the user's fixed cap on drone 1's height (2026-11-15: never above 5 m; hover_ceiling went to 5.5 before; 1.5 and 3 until 2026-11-12, then 3 and 3.5) so the hold can sit high enough for the flip (flip_height up to 5) and its staged tests: the first real flip lost 1.2 m before it tumbled, and the fitted sim loses up to 3 m in its worst plants.
TUNE(hover_climb, hover.climb, 1, 0, 5, 0.3)
TUNE(hover_climb_rate, hover.climb_rate, 1, 0.05, 1, 0.3)
TUNE(hover_land_rate, hover.land_rate, 1, 0.05, 0.5, 0.2)
TUNE(hover_kyaw, hover.kyaw, 1, 0, 10, 2)
TUNE(hover_yaw_rate, hover.yaw_rate, RAD, 0, 90, 30)
TUNE(hover_center, hover.center, 1, 0, 1, 1)
TUNE(hover_distance, hover.distance, 1, 0, 5, 1.79)
TUNE(hover_approach, hover.approach, 1, 0.02, 1, 0.25)
TUNE(hover_ceiling, hover.ceiling, 1, 0.2, 5, 1.8)
TUNE(hover_square, hover.square, 1, 0, 1, 1)
TUNE(hover_cam_pitch, hover.cam_pitch, RAD, -30, 30, 4.3)
TUNE(hover_cam_roll, hover.cam_roll, RAD, -180, 180, 0)
TUNE(hover_drag, hover.drag, 1, 0, 2, 0)
TUNE(hover_drag_tilt, hover.drag_tilt, RAD, -10, 10, 1.4)
TUNE(hover_drag_tau, hover.drag_tau, 1, 0.1, 10, 0.7)
TUNE(hover_trim_tau, hover.trim_tau, 1, 0.1, 20, 1.5)
TUNE(hover_trim_max, hover.trim_max, 1, 0, 3, 1)
TUNE(hover_thrust_tilt, hover.thrust_tilt, 1, 0, 1.5, 0)
TUNE(hover_thrust_tilt_tau, hover.thrust_tilt_tau, 1, 0.05, 10, 1)
TUNE(hover_trim_start_x, hover.trim_start_x, 1, -3, 3, 0)
TUNE(hover_trim_start_y, hover.trim_start_y, 1, -3, 3, 0)
TUNE(hover_speed_tilt, hover.speed_tilt, RAD, 0, 20, 0)
TUNE(hover_speed_pitch, hover.speed_pitch, 1, -2, 2, -0.54)
TUNE(hover_speed_takeoff, hover.speed_takeoff, RAD, -10, 10, 1.6)
TUNE(hover_speed_tau, hover.speed_tau, 1, 0.05, 10, 1)
TUNE(hover_nudge_speed, hover.nudge_speed, 1, 0.05, 5, 0.5)
TUNE(hover_view, hover.view, RAD, 0, 30, 10)
TUNE(hover_gps_tau, hover.gps_tau, 1, 0, 10, 0)
TUNE(hover_gps_place_tau, hover.gps_place_tau, 1, 0, 30, 2)
TUNE(hover_baro_tau, hover.baro_tau, 1, 0, 10, 0)
TUNE(hover_thrust_direction, hover.thrust_direction, 1, 0, 1.5, 0)
TUNE(hover_gps_calibrate, hover.gps_calibrate, RAD, 0, 10, 5)
TUNE(hover_return_speed, hover.return_speed, 1, 0, 5, 1)
TUNE(hover_nudge_accel, hover.nudge_accel, 1, 0, 5, 0)
TUNE(auto_trim, auto_trim, 1, 0, 1, 0)
TUNE(pitch_damping_tau, pitch_damping_tau, 1, 0, 0.2, 0)
// The radio (radio.c, fw/link.h): the rate this drone sends at (link_rates index: 0 1 Mbps, 1 long range 500 kbps, 2 long range 250 kbps, 3 2 Mbps, 4 5.5 Mbps, 5 11 Mbps, 6 802.11g 6 Mbps), its maximum transmit power in dBm (0 = the driver's own, 20 dBm on the ESP32), and whether a disarmed drone that lost its controller looks for it on channels 1, 6 and 11 (1). The controller hears every rate, so the rate and power change only this drone's packets; the defaults are the link as flown before 2026-11-09.
TUNE(radio_rate, radio_rate, 1, 0, 6, 0)
TUNE(radio_power, radio_power, 1, 0, 20, 0)
TUNE(radio_follow, radio_follow, 1, 0, 1, 0)
// The fly-away failsafe and the test pattern's limits (guard.h; 0 turns a speed, distance or pattern check off). failsafe_land 3 s and failsafe_tilt 20 degrees: in sw/sim/outdoor.py (2026-11-09 06:38 UTC settings, GPS and barometer, 48 runs per wind) they held the worst tenth's furthest distance from takeoff at 4 m/s of wind to 30 m, against 43 m at 5 s and 15 degrees and 85 m without the failsafe, with no more runs lost.
TUNE(failsafe_speed, guard.speed, 1, 0, 10, 2)
TUNE(failsafe_distance, guard.distance, 1, 0, 200, 10)
TUNE(failsafe_time, guard.time, 1, 0.2, 10, 1.5)
TUNE(failsafe_land, guard.land, 1, 1, 30, 3)
TUNE(failsafe_tilt, guard.tilt, RAD, 0, 30, 20)
TUNE(pattern_distance, guard.pattern_distance, 1, 0, 10, 0.7)
TUNE(pattern_tilt, guard.pattern_tilt, RAD, 0, 60, 30)
// The tilt past which the motors stop in flight (flight_rt.c; degrees). 45 as the constant was; raised only to fly measured steps past it.
TUNE(tip_limit, tip_limit, RAD, 20, 80, 45)
// The attitude estimate's pull toward the accelerometer with the motors spinning (flight_rt.c; time constant, s). 50 is the 0.9998 retained per 10 ms tick it always was. Replaying the 2026-11-11 evening and 2026-11-14 GPS hovers against the Kalman filter's attitude, 50 left the gyro's drift in (mean |roll| off 1.33, pitch 1.71 degrees; on 2026-11-14 1.5 and 2.5 degrees with the raw accelerometer within 0.7 of the filter, which the roll_bias auto-trim absorbed), 5 cut it to 0.95 and 1.39 and 2 added the accelerometer's vibration back; in a hover the accelerometer reads the thrust axis, which at hover tilts and speeds is within about 0.5 degrees of gravity (servo tilt and rotor drag fitted from the same logs). The flip and the recovery fly on the gyro alone.
TUNE(attitude_tau, attitude_tau, 1, 1, 100, 50)
// The roll flip (flip.c, fw/FLIP.md): 1 lets the laptop's flip request (radio.c f) start one per arming from a settled GPS hold at least flip_height (m above where the hold engaged) up; 2, 3 and 4 the staged tests instead, a burst of the spin braked at once, aimed at 60, 90 or 30 degrees and back (flip.c flip_turn; 4 added 2026-11-15 after the 60-degree quaternion burst's pitch broke at the roll's brake: half the angle, about 70% of the rate); 0, the default, refuses every request.
TUNE(flip_enable, flip_enable, 1, 0, 4, 0)
TUNE(flip_height, flip_height, 1, 2.5, 5, 3)
// Tumble recovery (recover.c, fw/FLIP.md): 1 rights and levels a drone past tip_limit in flight, or whose flip fails after its hand-back, or whose gyro reaches its full scale, and hands it to the hold, instead of the tip cut stopping the motors; 0, the default, cuts as before. On the ground, landing below 1 m and after RECOVER_MAX recoveries the tip cut stays.
TUNE(recover_enable, recover_enable, 1, 0, 1, 0)
// Incremental nonlinear dynamic inversion (indi.c, flight_rt.c): in roll and yaw (indi_pitch below is pitch's) the share (0-1) of the angular acceleration the gyro measures beyond what the models give for the actuators as estimated (servo dead time and lag, the assemblies' swing, motor lag) that the attitude controller, the flip and the recovery take off what they ask, faded in over half a second once the hold flies 0.3 m above where it engaged (and out below that, on landing and in manual flight); the rotors' gyroscopic feedforwards in the flip give way by the same share, and a servo at its stop gives up yaw before pitch. 0, the default, flies as before. Much over 0.5 rings the motor assemblies' links (about 11 Hz) in the sim.
TUNE(indi, indi, 1, 0, 1, 0)
// INDI's share in pitch alone (as indi is in roll and yaw; 0 off). On 2026-11-15 indi 0.25 and 0.5 on all axes doubled the hover's 2.6-3 Hz pitch shake (pitch rate 7.8 deg/s RMS in 2-4 Hz without, 13.9 and 15.3 with), the mode pitch_damping over 6 drives, while roll steadied (roll 1.2 -> 0.7 degrees RMS at 0.5).
TUNE(indi_pitch, indi_pitch, 1, 0, 1, 0)
// The quaternion attitude (flight_math.c, flip.c, recover.c): 1 carries the attitude as one quaternion (the gyro turning it, the accelerometer pulling its up as the Euler estimate's blend does, gated as before), the attitude controller's roll and pitch errors are the tilt-prioritized error onto the setpoint at the drone's own heading, the bursts (flip_enable 2 and 3) track one reference rotation with the same law in place of the spin and the righting, never over the lower of hover_ceiling and 5 m, the whole flip (flip_enable 1) is refused, and the flip and the recovery fly the estimate itself, with no Euler hand-back and no roll-over (sw/sim/models/NOTES.md "Quaternion attitude"); 0, the default, flies the Euler angles as before.
TUNE(quaternion, quaternion, 1, 0, 1, 0)
// BOOT(name, min, max, default): changed by the T request like TUNE, but read only at boot rather than copied into the controller's command. Where an include site does not name BOOT it is a TUNE without a member.
#ifndef BOOT
#define BOOT(name, min, max, value) TUNE(name, , 1, min, max, value)
#define BOOT_AS_TUNE
#endif
// 1: the drone's ESP-NOW link goes through the camera's radio and u.FL dipole over their wire (fw/relay_link.h) instead of this board's antenna under the GPS; 0: its own radio. Takes effect at the next restart (T, then R), which also sets the camera's mode.
BOOT(radio_via_camera, 0, 1, 0)
#ifdef BOOT_AS_TUNE
#undef BOOT
#undef BOOT_AS_TUNE
#endif
STATE(servo_offset_left, -60, 60, -3)
STATE(servo_offset_right, -60, 60, 0)
// Gyro bias in rad/s and the stationary pose in degrees, valid only for the sensor frame they were taken in:
// calibration_frame holds the sign bits (x 1, y 2, z 4) of runtime.h sensor_to_body and the sensor_axis order above them.
STATE(gyro_bias_x, -1, 1, 0)
STATE(gyro_bias_y, -1, 1, 0)
STATE(gyro_bias_z, -1, 1, 0)
// The drone's level attitude as the IMU sees it, set by tools/level.py.
STATE(pose_zero_roll, -180, 180, 0)
STATE(pose_zero_pitch, -90, 90, 0)
// Accelerometer correction in body axes, from tools/accel_cal.py: corrected = (measured - offset) * gain, in g.
STATE(accel_offset_x, -0.2, 0.2, 0)
STATE(accel_offset_y, -0.2, 0.2, 0)
STATE(accel_offset_z, -0.2, 0.2, 0)
STATE(accel_gain_x, 0.8, 1.2, 1)
STATE(accel_gain_y, 0.8, 1.2, 1)
STATE(accel_gain_z, 0.8, 1.2, 1)
STATE(calibrated, 0, 1, 0)
STATE(calibration_frame, 0, 511, 0)
