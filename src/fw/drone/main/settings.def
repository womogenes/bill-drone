// The drone's settings: the one list that names, bounds, defaults and persists every value (settings.c).
// TUNE(name, Command member, scale to the member, min, max, default): changed by the T request.
// STATE(name, min, max, default): set only by IMU calibration (G), servo zeroing (Z), accel correction (Q) and the level reference (L); read-only to T.
// Every entry is persisted in NVS. Angles are degrees here; DEGREE (hover.h) converts them to the controller's radians.
// The model defaults match sw/sim/flight.py MODEL, which the host simulation uses. The gains' defaults are the earlier ones scaled from the model they had (14.5, 11.0 and 16.1 rad/s² per N) to this one.
TUNE(roll_p, roll_p, 1, 0, 1000, 11)
TUNE(roll_i, roll_i, 1, 0, 1000, 1.65)
TUNE(roll_damping, roll_damping, 1, 0, 1000, 3.3)
TUNE(pitch_p, pitch_p, 1, 0, 1000, 15.8)
TUNE(pitch_i, pitch_i, 1, 0, 1000, 2.36)
TUNE(pitch_damping, pitch_damping, 1, 0, 1000, 7.88)
TUNE(yaw_damping, yaw_damping, 1, 0, 1000, 2.82)
TUNE(integral_limit, integral_limit, 1, 0, 1000, 3)
TUNE(pitch_trim, pitch_trim, DEGREE, -15, 15, 0)
TUNE(left_trim, left_trim, DEGREE, -15, 15, 0.9)
TUNE(right_trim, right_trim, DEGREE, -15, 15, -0.9)
// The airframe's authority, the one model the attitude controller allocates on, INDI and the servos' dead-time predictor estimate on, and the burst and the recovery fly on (flight_math.h Model): angular acceleration (rad/s²) per newton of the left motor's thrust over the right's, per newton of the two's thrust per radian of their common forward tilt, per newton per radian of the right's forward tilt over the left's (newtons of the thrust table). Fitted to foretell drone 1's body rates 50 ms ahead through INDI's actuator estimate on the new ESCs' flights since the pivots were raised (sw/sim/authority.py; held out: 0.66-0.79 of the roll rate's change explained, 0.79-0.89 of pitch's, 0.41-0.66 of yaw's, against 0.23-0.62, 0.05-0.89 and 0.21-0.64 by the four models the controller, the predictor and the burst had before). They replace arm, pivot_height, com_x, the three inertias and reaction_torque_ratio: an older blob's gains are scaled once to them (settings.c), so the controller asks the motors and servos for what it did.
TUNE(roll_authority, model.roll, 1, 0.1, 100, 8.0)
TUNE(pitch_authority, model.pitch, 1, 0.1, 100, 8.68)
TUNE(yaw_authority, model.yaw, 1, 0.1, 100, 11.35)
TUNE(roll_bias, roll_bias, 1, -20, 20, 0)
TUNE(pitch_bias, pitch_bias, 1, -20, 20, 0)
TUNE(yaw_bias, yaw_bias, 1, -10, 10, 0)
TUNE(left_thrust_scale, left_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(right_thrust_scale, right_thrust_scale, 1, 0.5, 1.5, 1)
TUNE(servo_compensation, servo_compensation, DEGREE, 0, 3, 0.75)
TUNE(integrate_throttle, integrate_throttle, 1, 0, 1200, 580)
TUNE(target_rate, target_rate, DEGREE, 1, 360, 360)
TUNE(roll_target_rate, roll_target_rate, DEGREE, 0, 360, 0)
TUNE(thrust_voltage, thrust_voltage, 1, 0, 20, 0)
TUNE(yaw_i, yaw_i, 1, 0, 100, 0)
TUNE(pitch_speed, pitch_speed, 1, -50, 50, 0)
TUNE(hover_camera, hover_camera, 1, 0, 1, 1)
TUNE(hover_kp, hover.kp, 1, 0, 20, 2)
TUNE(hover_kd, hover.kd, 1, 0, 20, 2)
TUNE(hover_tilt, hover.tilt, DEGREE, 0, 30, 8)
TUNE(hover_kside, hover.kside, 1, 0, 5, 0.5)
TUNE(hover_kz, hover.kz, 1, 0, 10, 1.5)
TUNE(hover_kdz, hover.kdz, 1, 0, 20, 4)
TUNE(hover_kiz, hover.kiz, 1, 0, 20, 2)
TUNE(hover_mass, hover.mass, 1, 0.3, 2, 0.9)
// hover_climb and hover_ceiling go to 5 m at most, the user's fixed cap on drone 1's height (2026-11-15), so the hold can sit high enough for the burst (flip_height up to 5).
TUNE(hover_climb, hover.climb, 1, 0, 5, 0.3)
TUNE(hover_climb_rate, hover.climb_rate, 1, 0.05, 1, 0.3)
TUNE(hover_land_rate, hover.land_rate, 1, 0.05, 0.5, 0.2)
TUNE(hover_kyaw, hover.kyaw, 1, 0, 10, 2)
TUNE(hover_yaw_rate, hover.yaw_rate, DEGREE, 0, 90, 30)
TUNE(hover_center, hover.center, 1, 0, 1, 1)
TUNE(hover_distance, hover.distance, 1, 0, 5, 1.79)
TUNE(hover_approach, hover.approach, 1, 0.02, 1, 0.25)
TUNE(hover_ceiling, hover.ceiling, 1, 0.2, 5, 1.8)
TUNE(hover_cam_pitch, hover.cam_pitch, DEGREE, -30, 30, 4.3)
TUNE(hover_cam_roll, hover.cam_roll, DEGREE, -180, 180, 0)
TUNE(hover_drag, hover.drag, 1, 0, 2, 0)
TUNE(hover_drag_tilt, hover.drag_tilt, DEGREE, -10, 10, 1.4)
TUNE(hover_drag_tau, hover.drag_tau, 1, 0.1, 10, 0.7)
TUNE(hover_trim_tau, hover.trim_tau, 1, 0.1, 20, 1.5)
TUNE(hover_trim_max, hover.trim_max, 1, 0, 3, 1)
TUNE(hover_thrust_tilt, hover.thrust_tilt, 1, 0, 1.5, 0)
TUNE(hover_thrust_tilt_tau, hover.thrust_tilt_tau, 1, 0.05, 10, 1)
TUNE(hover_trim_start_x, hover.trim_start_x, 1, -3, 3, 0)
TUNE(hover_trim_start_y, hover.trim_start_y, 1, -3, 3, 0)
TUNE(hover_speed_tilt, hover.speed_tilt, DEGREE, 0, 20, 0)
TUNE(hover_speed_pitch, hover.speed_pitch, 1, -2, 2, -0.54)
TUNE(hover_speed_takeoff, hover.speed_takeoff, DEGREE, -10, 10, 1.6)
TUNE(hover_speed_tau, hover.speed_tau, 1, 0.05, 10, 1)
TUNE(hover_nudge_speed, hover.nudge_speed, 1, 0.05, 5, 0.5)
TUNE(hover_view, hover.view, DEGREE, 0, 30, 10)
TUNE(hover_gps_tau, hover.gps_tau, 1, 0, 10, 0)
TUNE(hover_gps_place_tau, hover.gps_place_tau, 1, 0, 30, 2)
TUNE(hover_baro_tau, hover.baro_tau, 1, 0, 10, 0)
TUNE(hover_thrust_direction, hover.thrust_direction, 1, 0, 1.5, 0)
TUNE(hover_gps_calibrate, hover.gps_calibrate, DEGREE, 0, 10, 5)
TUNE(hover_return_speed, hover.return_speed, 1, 0, 5, 1)
TUNE(hover_nudge_accel, hover.nudge_accel, 1, 0, 5, 0)
TUNE(auto_trim, auto_trim, 1, 0, 1, 0)
TUNE(pitch_damping_tau, pitch_damping_tau, 1, 0, 0.2, 0)
// The fly-away failsafe and the test pattern's limits (guard.h; 0 turns a speed, distance or pattern check off). failsafe_land 3 s and failsafe_tilt 20 degrees: in sw/sim/outdoor.py (2026-11-09 06:38 UTC settings, GPS and barometer, 48 runs per wind) they held the worst tenth's furthest distance from takeoff at 4 m/s of wind to 30 m, against 43 m at 5 s and 15 degrees and 85 m without the failsafe, with no more runs lost.
TUNE(failsafe_speed, guard.speed, 1, 0, 10, 2)
TUNE(failsafe_distance, guard.distance, 1, 0, 200, 10)
TUNE(failsafe_time, guard.time, 1, 0.2, 10, 1.5)
TUNE(failsafe_land, guard.land, 1, 1, 30, 3)
TUNE(failsafe_tilt, guard.tilt, DEGREE, 0, 30, 20)
TUNE(pattern_distance, guard.pattern_distance, 1, 0, 10, 0.7)
TUNE(pattern_tilt, guard.pattern_tilt, DEGREE, 0, 60, 30)
// The tilt past which the motors stop in flight (flight_rt.c; degrees). 45 as the constant was; raised only to fly measured steps past it.
TUNE(tip_limit, tip_limit, DEGREE, 20, 80, 45)
// The attitude estimate's pull toward the accelerometer with the motors spinning (flight_rt.c; time constant, s). 50 is the 0.9998 retained per 10 ms tick it always was. Replaying the 2026-11-11 evening and 2026-11-14 GPS hovers against the Kalman filter's attitude, 50 left the gyro's drift in (mean |roll| off 1.33, pitch 1.71 degrees; on 2026-11-14 1.5 and 2.5 degrees with the raw accelerometer within 0.7 of the filter, which the roll_bias auto-trim absorbed), 5 cut it to 0.95 and 1.39 and 2 added the accelerometer's vibration back; in a hover the accelerometer reads the thrust axis, which at hover tilts and speeds is within about 0.5 degrees of gravity (servo tilt and rotor drag fitted from the same logs). The flip and the recovery fly on the gyro alone.
TUNE(attitude_tau, attitude_tau, 1, 1, 100, 50)
// The burst (flip.c, fw/FLIP.md): the laptop's flip request (radio.c f) starts one per arming from a settled GPS hold at least flip_height (m above where the hold engaged) up, rolling to flip_angle (degrees) and back; 0, the default, refuses every request. Up to 90: the sim has flown 30, 60 and 90 (sw/sim/flip_esc.py), and the whole roll it no longer flies (under the 5 m cap it has no room to climb first).
TUNE(flip_angle, flip_angle, DEGREE, 0, 90, 0)
TUNE(flip_height, flip_height, 1, 2.5, 5, 3)
// Tumble recovery (recover.c, fw/FLIP.md): 1 rights and levels a drone past tip_limit in flight, or whose flip fails after its hand-back, or whose gyro reaches its full scale, and hands it to the hold, instead of the tip cut stopping the motors; 0, the default, cuts as before. On the ground, landing below 1 m and after RECOVER_MAX recoveries the tip cut stays.
TUNE(recover_enable, recover_enable, 1, 0, 1, 0)
// Incremental nonlinear dynamic inversion (indi.c, flight_rt.c): in roll and yaw (indi_pitch below is pitch's) the share (0-1) of the angular acceleration the gyro measures beyond what the model gives for the actuators as estimated (servo dead time and lag, the assemblies' swing, motor lag) that the attitude controller, the burst and the recovery take off what they ask, faded in over half a second once the hold flies 0.3 m above where it engaged (and out below that, on landing and in manual flight); the rotors' gyroscopic feedforwards in the flip give way by the same share, and a servo at its stop gives up yaw before pitch. 0, the default, flies as before. Much over 0.5 rings the motor assemblies' links (about 11 Hz) in the sim.
TUNE(indi, indi, 1, 0, 1, 0)
// INDI's share in pitch alone (as indi is in roll and yaw; 0 off), for the hold, the burst and the recovery alike. On 2026-11-15 indi 0.25 and 0.5 on all axes doubled the hover's 2.6-3 Hz pitch shake (pitch rate 7.8 deg/s RMS in 2-4 Hz without, 13.9 and 15.3 with), the mode pitch_damping over 6 drives, while roll steadied (roll 1.2 -> 0.7 degrees RMS at 0.5).
TUNE(indi_pitch, indi_pitch, 1, 0, 1, 0)
// The servos' dead-time predictor in pitch (indi.c indi_predict, a Smith predictor), for the hold, the burst and the recovery alike: the share (0 off, 1 the model as fitted) of the pitch and pitch rate change that the servo commands already on their way will make, which the P and damping terms act on as if it had happened; faded in with INDI. The servos' 55-75 ms dead time is most of the 80-95 ms the pitch loop's phase carries at its 2.3-2.5 Hz shake. On the airframe's fitted model (settings.def roll_authority; no scale on it since 2026-11-15) the prediction is the drone's own size (slope 0.78-1.08 against the gyro's change 50 ms ahead on held-out flights), and the sims (sw/sim/models/NOTES.md "One model") take 1 at pitch_damping 4.5: the hover shake 15 -> 2.4 deg/s on the fitted plant and 10 -> 2.1 with the logs' servo, burst60 clean in 89-91% of runs; at pitch_damping 6 a share of 1 sometimes rings at 2.7 Hz on the fitted plant.
TUNE(pitch_predict, pitch_predict, 1, 0, 1, 0)
STATE(servo_offset_left, -60, 60, -3)
STATE(servo_offset_right, -60, 60, 0)
// Gyro bias in rad/s and the stationary pose in degrees, valid only for the sensor frame they were taken in:
// calibration_frame holds the sign bits (x 1, y 2, z 4) of runtime.h sensor_to_body and the sensor_axis order above them.
STATE(gyro_bias_x, -1, 1, 0)
STATE(gyro_bias_y, -1, 1, 0)
STATE(gyro_bias_z, -1, 1, 0)
// The drone's level attitude as the IMU sees it, set by tools/level.py.
STATE(pose_zero_roll, -180, 180, 0)
STATE(pose_zero_pitch, -90, 90, 0)
// Accelerometer correction in body axes, from tools/accel_cal.py: corrected = (measured - offset) * gain, in g.
STATE(accel_offset_x, -0.2, 0.2, 0)
STATE(accel_offset_y, -0.2, 0.2, 0)
STATE(accel_offset_z, -0.2, 0.2, 0)
STATE(accel_gain_x, 0.8, 1.2, 1)
STATE(accel_gain_y, 0.8, 1.2, 1)
STATE(accel_gain_z, 0.8, 1.2, 1)
STATE(calibrated, 0, 1, 0)
STATE(calibration_frame, 0, 511, 0)
