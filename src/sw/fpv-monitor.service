# FPV over the radio through the USB Wi-Fi adapter in monitor mode (src/sw/fpv_monitor.py), as root for monitor mode and raw frames. Install once:
#   sudo pacman -S --needed iw && sudo install -m644 src/sw/fpv-monitor.service /etc/systemd/system/bill-fpv-monitor.service && sudo systemctl daemon-reload && sudo systemctl enable --now bill-fpv-monitor
[Unit]
Description=bill-drone FPV monitor-mode receiver
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/willi/coding/ee/bill-drone/src/sw/fpv_monitor.py --interface wlan1 --channel 11
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
